# Скопируйте в .env и заполните. Файл .env не коммитить!

# --- Django
DJANGO_SECRET_KEY=сгенерируйте: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=0
DEMO_MODE=0
SITE_DOMAIN=zakupki.company.kz
SITE_URL=https://zakupki.company.kz
DJANGO_ALLOWED_HOSTS=zakupki.company.kz
DJANGO_CSRF_TRUSTED_ORIGINS=https://zakupki.company.kz
DJANGO_HTTPS=1
DJANGO_ADMINS=admin@company.kz
GUNICORN_WORKERS=3
TIME_ZONE=Asia/Almaty

# --- PostgreSQL
POSTGRES_DB=zakupki
POSTGRES_USER=zakupki
POSTGRES_PASSWORD=придумайте-длинный-пароль

# --- Почта для уведомлений (пусто — только уведомления в системе)
EMAIL_HOST=smtp.company.kz
EMAIL_PORT=587
EMAIL_HOST_USER=zakupki@company.kz
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Закупки <zakupki@company.kz>

# --- Обмен с 1С через папку (пусто — только ручной обмен через интерфейс)
ONEC_EXCHANGE_DIR=/exchange
ONEC_EXCHANGE_HOST_DIR=/srv/1c-exchange
ONEC_COLLAPSE_CONSOLIDATED=0

# --- Бэкапы
BACKUP_HOST_DIR=/srv/zakupki-backups
BACKUP_KEEP_DAYS=14

# --- Бизнес-параметры
AUTO_CLOSE_DAYS=14
URGENT_SLA_DAYS=2
POOL_STALE_DAYS=5
DEADLINE_WARN_DAYS=10
